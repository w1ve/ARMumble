{
  "productName": "RemoteRadioClient",
  "version": "0.3.0",
  "identifier": "com.remoteradio.client",
  "build": {
    "frontendDist": "../mumble-tauri/ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../mumble-tauri/ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../mumble-tauri/ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemoteRadio Client",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCODZEMTk5QTVCRDM4MzEKUldReE9MMmxtZEdHZS90QmRQbGZZMHZqL01oeUhDekx5SUMwY08yc1N6aC84RE1LSVR6aTRJRFYK",
      "endpoints": [
        "https://github.com/w1ve/ARMumble/releases/latest/download/latest-client.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
